# ---------------------------------------------------------------------------
# Aurati Studio — environment template
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real keys.
# ---------------------------------------------------------------------------

# --- Google AI Studio (the only provider required for v1) -------------------
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Image generation / editing / harmonization model ("Nano Banana").
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Provider selection -----------------------------------------------------
# "gemini" = live API calls (costs money).  "dryrun" = cached sample outputs,
# zero spend, used for UI development and tests.
IMAGE_PROVIDER=gemini

# --- Budget guardrail -------------------------------------------------------
# Hard cap on estimated spend per product. Generation stops and warns before
# exceeding this. Editable in Settings at runtime.
BUDGET_CAP_INR_PER_PRODUCT=100
USD_TO_INR=88.0

# --- Background removal -----------------------------------------------------
# rembg session name. birefnet-general gives the cleanest jewellery mattes;
# u2netp is much faster if you are iterating.
REMBG_MODEL=birefnet-general

# --- Server -----------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Storage ----------------------------------------------------------------
DATA_DIR=./data
OUTPUT_DIR=./outputs

# --- Future (v2, not used in v1) -------------------------------------------
# VEO_MODEL=veo-3.0-generate-001
# FAL_KEY=
